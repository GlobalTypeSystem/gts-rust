{
  "$id": "gts://gts.x.test.ovr4.event.v1~x.test.ovr4.order.v1~x.test.ovr4.placed.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "gts://gts.x.test.ovr4.event.v1~x.test.ovr4.order.v1~"
    },
    {
      "properties": {
        "payload": {
          "properties": {
            "details": {
              "additionalProperties": false,
              "properties": {
                "delivery": {
                  "type": "object"
                },
                "order_id": {
                  "maxLength": 64,
                  "type": "string"
                }
              },
              "required": [
                "order_id",
                "delivery"
              ],
              "type": "object"
            },
            "region": {
              "enum": [
                "eu-west",
                "eu-central"
              ],
              "type": "string"
            }
          },
          "required": [
            "region"
          ],
          "type": "object"
        },
        "subject_id": {
          "format": "uuid",
          "maxLength": 36,
          "minLength": 36,
          "type": "string"
        },
        "subject_type": {
          "type": "string",
          "x-gts-type-ref": "gts.x.core.orders.order.v1~"
        }
      },
      "required": [
        "subject_id",
        "subject_type"
      ],
      "type": "object"
    }
  ],
  "description": "Order placed in the EU",
  "type": "object"
}
