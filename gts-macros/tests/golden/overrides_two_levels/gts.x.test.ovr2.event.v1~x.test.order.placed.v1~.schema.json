          ],
          "type": "object"
        },
        "subject_id": {
          "format": "uuid",
          "maxLength": 36,
          "minLength": 36,
          "type": "string"
        },
        "subject_type": {
          "type": "string",
          "x-gts-type-ref": "gts.x.core.orders.order.v1~"
        }
      },
      "required": [
        "subject_id",
        "subject_type"
      ],
      "type": "object"
    }
  ],
  "description": "Order placed with a UUID subject ID",
  "type": "object"
}
