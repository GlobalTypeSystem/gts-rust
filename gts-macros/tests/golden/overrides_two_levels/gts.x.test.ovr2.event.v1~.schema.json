{
  "$id": "gts://gts.x.test.ovr2.event.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Event envelope",
  "properties": {
    "id": {
      "description": "GTS instance identifier",
      "title": "GTS Instance ID",
      "type": "string",
      "x-gts-instance-ref": "gts.*"
    },
    "payload": {
      "type": "object"
    },
    "subject_id": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "subject_type": {
      "description": "GTS type identifier",
      "title": "GTS Type ID",
      "type": "string",
      "x-gts-type-ref": "gts.*"
    }
  },
  "required": [
    "id",
    "subject_id",
    "subject_type",
    "payload"
  ],
  "type": "object"
}
